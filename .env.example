# ---- Backend (server/) ----
# Neon connection string, pasted exactly as copied from Neon → Connect.
# Leave empty to run without a database (the app keeps working on its own data).
DATABASE_URL=

# Daily Guide online chat (optional). Without a key, chat answers on the phone only.
GUIDE_AI_PROVIDER=gemini          # gemini or anthropic
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GUIDE_MODEL=                    # optional override, e.g. a model listed by `npm run check:ai`

PORT=4000

# ---- App (Vite) ----
# Where the app finds the backend. For the APK, use your Render URL (https://...onrender.com).
# On a phone during local testing, use your computer's LAN IP, not localhost.
VITE_API_BASE_URL=http://localhost:4000
